<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamflow.core.importjob.mapper.ImportJobMapper">
    <resultMap id="importJobResultMap"
               type="com.teamflow.core.importjob.domain.ImportJob">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="project_id" javaType="string"/>
            <arg column="creator_id" javaType="string"/>
            <arg column="original_file_name" javaType="string"/>
            <arg column="storage_path" javaType="string"/>
            <arg column="job_status"
                 javaType="com.teamflow.core.importjob.domain.ImportJobStatus"/>
            <arg column="total_rows" javaType="_long"/>
            <arg column="success_rows" javaType="_long"/>
            <arg column="failed_rows" javaType="_long"/>
            <arg column="error_file_path" javaType="string"/>
            <arg column="created_at" javaType="string"/>
            <arg column="started_at" javaType="string"/>
            <arg column="finished_at" javaType="string"/>
        </constructor>
    </resultMap>

    <sql id="importJobColumns">
        id,
        project_id,
        creator_id,
        original_file_name,
        storage_path,
        job_status,
        total_rows,
        success_rows,
        failed_rows,
        error_file_path,
        created_at,
        started_at,
        finished_at
    </sql>

    <insert id="insert">
        INSERT INTO import_jobs (
        <include refid="importJobColumns"/>
        ) VALUES (
        #{id},
        #{projectId},
        #{creatorId},
        #{originalFileName},
        #{storagePath},
        #{status},
        #{totalRows},
        #{successRows},
        #{failedRows},
        #{errorFilePath},
        #{createdAt},
        #{startedAt},
        #{finishedAt}
        )
    </insert>

    <select id="findById" resultMap="importJobResultMap">
        SELECT
        <include refid="importJobColumns"/>
        FROM import_jobs
        WHERE id = #{id}
    </select>

    <update id="update">
        UPDATE import_jobs
        SET job_status = #{importJob.status},
            total_rows = #{importJob.totalRows},
            success_rows = #{importJob.successRows},
            failed_rows = #{importJob.failedRows},
            error_file_path = #{importJob.errorFilePath},
            started_at = #{importJob.startedAt},
            finished_at = #{importJob.finishedAt}
        WHERE id = #{importJob.id}
          AND job_status = #{expectedStatus}
    </update>
</mapper>
