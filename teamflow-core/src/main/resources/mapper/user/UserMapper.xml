<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamflow.core.user.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.teamflow.core.user.domain.User">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="username" javaType="string"/>
            <arg column="email" javaType="string"/>
            <arg column="password_hash" javaType="string"/>
            <arg column="display_name" javaType="string"/>
            <arg column="avatar_url" javaType="string"/>
            <arg column="status" javaType="com.teamflow.core.user.domain.UserStatus"/>
            <arg column="version" javaType="_int"/>
            <arg column="created_at" javaType="string"/>
            <arg column="updated_at" javaType="string"/>
        </constructor>
    </resultMap>

    <sql id="userColumns">
        id,
        username,
        email,
        password_hash,
        display_name,
        avatar_url,
        status,
        version,
        created_at,
        updated_at
    </sql>

    <insert id="insert">
        INSERT INTO users (
        <include refid="userColumns"/>
        ) VALUES (
        #{id},
        #{username},
        #{email},
        #{passwordHash},
        #{displayName},
        #{avatarUrl},
        #{status},
        #{version},
        #{createdAt},
        #{updatedAt}
        )
    </insert>

    <select id="findById" resultMap="userResultMap">
        SELECT
        <include refid="userColumns"/>
        FROM users
        WHERE id = #{id}
    </select>

    <select id="findByIdentifier" resultMap="userResultMap">
        SELECT
        <include refid="userColumns"/>
        FROM users
        WHERE username = #{identifier}
           OR email = #{identifier}
    </select>

    <select id="countById" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE id = #{id}
    </select>

    <select id="countByUsername" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE username = #{username}
    </select>

    <select id="countByEmail" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE email = #{email}
    </select>

    <update id="update">
        UPDATE users
        SET display_name = #{user.displayName},
            avatar_url = #{user.avatarUrl},
            status = #{user.status},
            version = #{user.version},
            updated_at = #{user.updatedAt}
        WHERE id = #{user.id}
          AND version = #{expectedVersion}
    </update>

</mapper>
