<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamflow.core.team.mapper.TeamMapper">

    <resultMap id="teamResultMap" type="com.teamflow.core.team.domain.Team">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="name" javaType="string"/>
            <arg column="description" javaType="string"/>
            <arg column="owner_id" javaType="string"/>
            <arg column="version" javaType="_int"/>
            <arg column="created_at" javaType="string"/>
            <arg column="updated_at" javaType="string"/>
        </constructor>
    </resultMap>

    <resultMap id="teamResponseResultMap" type="com.teamflow.core.team.dto.TeamResponse">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="name" javaType="string"/>
            <arg column="description" javaType="string"/>
            <arg column="owner_id" javaType="string"/>
            <arg column="version" javaType="_int"/>
            <arg column="created_at" javaType="string"/>
            <arg column="updated_at" javaType="string"/>
            <arg column="current_user_role"
                 javaType="com.teamflow.core.team.domain.TeamRole"/>
        </constructor>
    </resultMap>

    <sql id="teamColumns">
        id,
        name,
        description,
        owner_id,
        version,
        created_at,
        updated_at
    </sql>

    <insert id="insert">
        INSERT INTO teams (
        <include refid="teamColumns"/>
        ) VALUES (
        #{id},
        #{name},
        #{description},
        #{ownerId},
        #{version},
        #{createdAt},
        #{updatedAt}
        )
    </insert>

    <select id="findById" resultMap="teamResultMap">
        SELECT
        <include refid="teamColumns"/>
        FROM teams
        WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="teamResultMap">
        SELECT
        <include refid="teamColumns"/>
        FROM teams
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <select id="findByUserId" resultMap="teamResponseResultMap">
        SELECT t.id,
               t.name,
               t.description,
               t.owner_id,
               t.version,
               t.created_at,
               t.updated_at,
               tm.member_role AS current_user_role
        FROM team_members tm
        INNER JOIN teams t ON t.id = tm.team_id
        WHERE tm.user_id = #{userId}
        ORDER BY t.created_at ASC, t.id ASC
    </select>

    <update id="update">
        UPDATE teams
        SET name = #{team.name},
            description = #{team.description},
            version = #{team.version},
            updated_at = #{team.updatedAt}
        WHERE id = #{team.id}
          AND version = #{expectedVersion}
    </update>

</mapper>
