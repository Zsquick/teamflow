<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamflow.core.team.mapper.TeamMemberMapper">

    <resultMap id="teamMemberResultMap" type="com.teamflow.core.team.domain.TeamMember">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="team_id" javaType="string"/>
            <arg column="user_id" javaType="string"/>
            <arg column="member_role"
                 javaType="com.teamflow.core.team.domain.TeamRole"/>
            <arg column="joined_at" javaType="string"/>
        </constructor>
    </resultMap>

    <resultMap id="teamMemberResponseResultMap"
               type="com.teamflow.core.team.dto.TeamMemberResponse">
        <constructor>
            <idArg column="user_id" javaType="string"/>
            <arg column="username" javaType="string"/>
            <arg column="display_name" javaType="string"/>
            <arg column="avatar_url" javaType="string"/>
            <arg column="member_role"
                 javaType="com.teamflow.core.team.domain.TeamRole"/>
            <arg column="joined_at" javaType="string"/>
        </constructor>
    </resultMap>

    <sql id="teamMemberColumns">
        id,
        team_id,
        user_id,
        member_role,
        joined_at
    </sql>

    <insert id="insert">
        INSERT INTO team_members (
        <include refid="teamMemberColumns"/>
        ) VALUES (
        #{id},
        #{teamId},
        #{userId},
        #{role},
        #{joinedAt}
        )
    </insert>

    <select id="findByTeamAndUser" resultMap="teamMemberResultMap">
        SELECT
        <include refid="teamMemberColumns"/>
        FROM team_members
        WHERE team_id = #{teamId}
          AND user_id = #{userId}
    </select>

    <select id="findByTeamAndUsersForUpdate"
            resultMap="teamMemberResultMap">
        SELECT
        <include refid="teamMemberColumns"/>
        FROM team_members
        WHERE team_id = #{teamId}
          AND user_id IN
          <foreach collection="userIds"
                   item="userId"
                   open="("
                   separator=","
                   close=")">
              #{userId}
          </foreach>
        ORDER BY user_id ASC
        FOR UPDATE
    </select>

    <select id="findByTeamId" resultMap="teamMemberResultMap">
        SELECT
        <include refid="teamMemberColumns"/>
        FROM team_members
        WHERE team_id = #{teamId}
        ORDER BY joined_at ASC, id ASC
    </select>

    <select id="findDetailsByTeamId"
            resultMap="teamMemberResponseResultMap">
        SELECT tm.user_id,
               u.username,
               u.display_name,
               u.avatar_url,
               tm.member_role,
               tm.joined_at
        FROM team_members tm
        INNER JOIN users u ON u.id = tm.user_id
        WHERE tm.team_id = #{teamId}
        ORDER BY tm.joined_at ASC, tm.id ASC
    </select>

    <update id="updateRole">
        UPDATE team_members
        SET member_role = #{newRole}
        WHERE team_id = #{teamId}
          AND user_id = #{userId}
          AND member_role = #{expectedRole}
    </update>

    <delete id="delete">
        DELETE FROM team_members
        WHERE team_id = #{teamId}
          AND user_id = #{userId}
          AND member_role = #{expectedRole}
    </delete>

</mapper>
