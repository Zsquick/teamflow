<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamflow.core.audit.mapper.OperationLogMapper">

    <resultMap id="operationLogResultMap"
               type="com.teamflow.core.audit.domain.OperationLog">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="user_id" javaType="string"/>
            <arg column="action" javaType="string"/>
            <arg column="resource_type" javaType="string"/>
            <arg column="resource_id" javaType="string"/>
            <arg column="detail" javaType="string"/>
            <arg column="success" javaType="_boolean"/>
            <arg column="duration_ms" javaType="_long"/>
            <arg column="trace_id" javaType="string"/>
            <arg column="ip_address" javaType="string"/>
            <arg column="created_at" javaType="string"/>
        </constructor>
    </resultMap>

    <sql id="operationLogColumns">
        id,
        user_id,
        action,
        resource_type,
        resource_id,
        detail,
        success,
        duration_ms,
        trace_id,
        ip_address,
        created_at
    </sql>

    <insert id="insert">
        INSERT INTO operation_logs (
        <include refid="operationLogColumns"/>
        ) VALUES (
        #{id},
        #{userId},
        #{action},
        #{resourceType},
        #{resourceId},
        #{detail},
        #{success},
        #{durationMs},
        #{traceId},
        #{ipAddress},
        #{createdAt}
        )
    </insert>

    <select id="findByResource" resultMap="operationLogResultMap">
        SELECT
        <include refid="operationLogColumns"/>
        FROM operation_logs
        WHERE resource_type = #{resourceType}
          AND resource_id = #{resourceId}
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
