TEAMFLOW_DB_PASSWORD=replace_me
TEAMFLOW_DB_ROOT_PASSWORD=replace_root_password
TEAMFLOW_REDIS_PASSWORD=replace_me
TEAMFLOW_RABBIT_USERNAME=teamflow
TEAMFLOW_RABBIT_PASSWORD=replace_me
TEAMFLOW_JWT_SECRET_BASE64=replace_with_base64_encoded_32_byte_or_longer_random_key
TEAMFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8088
TEAMFLOW_WEBHOOK_ENABLED=false
TEAMFLOW_WEBHOOK_ENDPOINT=https://example.invalid/teamflow-events
TEAMFLOW_WEBHOOK_HMAC_SECRET=replace_only_when_webhook_is_enabled

# 可选：数据库连接池和通用定时任务线程池。
# TEAMFLOW_DB_POOL_SIZE=10
# TEAMFLOW_DB_MIN_IDLE=2
# TEAMFLOW_DB_CONNECTION_TIMEOUT=3000
# TEAMFLOW_DB_VALIDATION_TIMEOUT=2000
# TEAMFLOW_SCHEDULER_POOL_SIZE=3

# 可选：HTTP 入口限流。Redis 暂时不可用时服务会记录告警并降级放行。
# TEAMFLOW_RATE_LIMIT_ENABLED=true
# TEAMFLOW_LOGIN_RATE_LIMIT=10
# TEAMFLOW_LOGIN_RATE_WINDOW=PT1M
# TEAMFLOW_REGISTRATION_RATE_LIMIT=5
# TEAMFLOW_REGISTRATION_RATE_WINDOW=PT10M
# TEAMFLOW_REFRESH_RATE_LIMIT=30
# TEAMFLOW_REFRESH_RATE_WINDOW=PT1M
# TEAMFLOW_UPLOAD_RATE_LIMIT=30
# TEAMFLOW_UPLOAD_RATE_WINDOW=PT1M

# 可选：事务 Outbox 发布批次、领取租期、确认超时和指数退避边界。
# TEAMFLOW_OUTBOX_BATCH_SIZE=50
# TEAMFLOW_OUTBOX_MAX_ATTEMPTS=5
# TEAMFLOW_OUTBOX_CLAIM_TTL=PT30S
# TEAMFLOW_OUTBOX_CONFIRM_TIMEOUT=PT5S
# TEAMFLOW_OUTBOX_RETRY_INITIAL_DELAY=PT2S
# TEAMFLOW_OUTBOX_RETRY_MAX_DELAY=PT1M
# TEAMFLOW_OUTBOX_SCAN_INTERVAL=PT2S

# 可选：本机默认端口冲突时修改，容器内部端口不变。
TEAMFLOW_MIDDLEWARE_BIND_ADDRESS=127.0.0.1
TEAMFLOW_MYSQL_HOST_PORT=3306
TEAMFLOW_REDIS_HOST_PORT=6379
TEAMFLOW_RABBIT_HOST_PORT=5672
TEAMFLOW_RABBIT_MANAGEMENT_HOST_PORT=15672
TEAMFLOW_WEB_HOST_PORT=8088

# 仅在叠加 compose.tls.yaml 时使用。先取消注释并填写宿主机上的证书路径。
# TEAMFLOW_TLS_CERTIFICATE_FILE=/absolute/path/to/fullchain.pem
# TEAMFLOW_TLS_PRIVATE_KEY_FILE=/absolute/path/to/privkey.pem

# 可选：叠加 compose.prod.yaml 时的资源上限。以下均已有合理默认值，按机器规格调整。
# TEAMFLOW_MYSQL_CPUS=1.00
# TEAMFLOW_MYSQL_MEMORY_LIMIT=768m
# TEAMFLOW_MYSQL_PIDS_LIMIT=256
# TEAMFLOW_REDIS_CPUS=0.50
# TEAMFLOW_REDIS_MEMORY_LIMIT=256m
# TEAMFLOW_REDIS_PIDS_LIMIT=128
# TEAMFLOW_RABBIT_CPUS=1.00
# TEAMFLOW_RABBIT_MEMORY_LIMIT=512m
# TEAMFLOW_RABBIT_PIDS_LIMIT=256
# TEAMFLOW_SERVER_CPUS=1.50
# TEAMFLOW_SERVER_MEMORY_LIMIT=768m
# TEAMFLOW_SERVER_PIDS_LIMIT=256
# TEAMFLOW_WEB_CPUS=0.50
# TEAMFLOW_WEB_MEMORY_LIMIT=128m
# TEAMFLOW_WEB_PIDS_LIMIT=64
